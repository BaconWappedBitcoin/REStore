import { defineConfig } from 'wxt';
import { defineManifest } from 'wxt/utils/manifest';

export default defineConfig({
  // Content script registration is generated by WXT from entrypoints/content.ts
  // and matches only *://sh.reddit.com/* (set in that file's defineContentScript).
  manifest: ({ browser }) =>
    defineManifest({
      name: 'REStore',
      description:
        'Restores the old Reddit look on sh.reddit.com, and keeps you on sh.reddit.com only.',
      version: '0.1.0',
      permissions: [
        'storage',
        // Chrome: network-level redirect of www/old/new reddit -> sh.reddit.com
        ...(browser === 'chrome' ? ['declarativeNetRequest'] : []),
        // Firefox: we redirect from a lightweight listener instead
        ...(browser === 'firefox' ? ['webRequest', 'webRequestBlocking'] : []),
      ],
      host_permissions: ['*://*.reddit.com/*'],
      options_ui: {
        page: 'options.html',
        open_in_tab: true,
      },
    }),
});
